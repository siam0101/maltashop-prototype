# Order service database (PostgreSQL)
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=order_pass
ORDER_DB_NAME=orders

# Message broker (RabbitMQ)
RABBITMQ_USER=maltashop
RABBITMQ_PASSWORD=maltashop

# Notification service database (SQLite file inside the container)
NOTIFICATION_DB_PATH=/data/notifications.db

# Logging
LOG_LEVEL=INFO